export default defineConfig({
  title: 'Eyelang',
  description: 'A language for software that keeps state and waits.',
  cleanUrls: true,
  lastUpdated: true,
  srcExclude: ['**/README.md', 'node_modules/**'],
  markdown: {
    languages: [{ ...eyelang, name: 'eye', aliases: ['eyelang'] }, { ...ebnf, name: 'ebnf' }],
  },
  themeConfig: {
    nav: [
      { text: 'Learn', link: '/quickstart', activeMatch: '^/(why|quickstart|tutorial|guide)' },
      { text: 'Reference', link: '/reference/', activeMatch: '^/reference/' },
      { text: 'Design', link: '/design/', activeMatch: '^/(design|internals)/' },
    ],
    sidebar: {
      '/reference/': [
        { text: 'Reference', link: '/reference/', items: [{ text: 'The eye command', link: '/reference/cli' }, { text: 'What runs today', link: '/reference/status' }] },
        { ...spec[0], collapsed: false },
        { text: 'API reference', link: '/reference/api/', items: apiPages() },
      ],
      '/design/': [spec[1], internals],
      '/internals/': [spec[1], internals],
      '/': learn,
    },
    outline: [2, 3],
    search: { provider: 'local' },
    socialLinks: [{ icon: 'github', link: repo }],
    editLink: {
      // Generated pages are edited at their source. VitePress runs this in the
      // browser, so it can't use anything from the rest of this file.
      pattern: ({ filePath }) => {
        // Eyelang 2 lives on dev until main takes it (ROADMAP.md).
        const repo = 'https://github.com/ruxxzebre/eyelang'
        if (/^(reference\/language|design)\//.test(filePath)) return `${repo}/blob/dev/SPECS.md`
        if (filePath.startsWith('reference/api/')) return `${repo}/tree/dev/check`
        if (filePath === 'reference/cli.md') return `${repo}/tree/dev/cmd/eye`
        return `${repo}/edit/dev/docs/${filePath}`
      },
      text: 'Edit this page',
    },
  },
})
