import { readFileSync, readdirSync } from 'node:fs'
import { dirname, join, relative } from 'node:path'
import { fileURLToPath } from 'node:url'
import { defineConfig, type DefaultTheme } from 'vitepress'

// The site is Markdown in this directory. Three parts of it are generated by
// `task generate` and must not be edited by hand:
//   reference/language/ and design/  from SPECS.md (tools/specpages)
//   reference/api/                   from ## comments (eye doc)

const docs = join(dirname(fileURLToPath(import.meta.url)), '..')
const repo = 'https://github.com/ruxxzebre/eyelang'

// Eyelang code is highlighted with the VS Code extension's TextMate grammar,
// so the site and the editor agree.
const eyelang = JSON.parse(
  readFileSync(join(docs, '../editors/vscode/syntaxes/eyelang.tmLanguage.json'), 'utf8'),
)

// The grammar sketch in the language reference is EBNF, which Shiki doesn't ship.
const ebnf = JSON.parse(readFileSync(join(docs, '.vitepress/ebnf.tmLanguage.json'), 'utf8'))

const spec: DefaultTheme.SidebarItem[] = JSON.parse(
  readFileSync(join(docs, '.vitepress/spec-sidebar.json'), 'utf8'),
)

// The API reference's pages, whatever eye doc wrote, titled by their front matter.
function apiPages(): DefaultTheme.SidebarItem[] {
  const out: DefaultTheme.SidebarItem[] = []
  const walk = (dir: string) => {
    for (const entry of readdirSync(dir, { withFileTypes: true })) {
      const path = join(dir, entry.name)
      if (entry.isDirectory()) walk(path)
      else if (entry.name.endsWith('.md') && entry.name !== 'index.md') {
        const title = /^title:\s*(.+)$/m.exec(readFileSync(path, 'utf8'))?.[1] ?? entry.name
        out.push({ text: title, link: '/' + relative(docs, path).replace(/\.md$/, '') })
      }
    }
  }
  walk(join(docs, 'reference/api'))
  return out.sort((a, b) => a.link!.localeCompare(b.link!))
}

