fn names(type: Int, state: State, view: View) -> Int {
  let test = type + 1
  let entity = job.start(contract)
  let impl = trait.import
  let extern = opaque.where
  let dyn = view.test
  let with2 = { state with view: view }
  start(view, test)
}

type Config = { type: String, state: Int, test: Bool }
