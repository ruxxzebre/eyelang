global Kettle.phase() -> Phase
b0:
  %1: Phase = Idle
  return %1

entity Kettle.brew(%1.state: Kettle) -> ()
b0:
  %6: () = ()
  %2: Phase = %1.state.phase
  %3: Phase = Idle
  %4: Bool = derived eq(%2, %3)
  branch %4 b1 b2
b1:
  %5: Phase = Brewing
  set %1.state.phase = %5
  jump b2
b2:
  return %6

entity Kettle.finish(%1.state: Kettle) -> ()
b0:
  %3: () = ()
  %2: Phase = Done
  set %1.state.phase = %2
  return %3

job boil(%1.id: String) -> ()
b0:
  %9: () = ()
  %2: Ref(Kettle) = runtime entity.ref Kettle(%1.id)
  %3: () = runtime! entity.call Kettle.brew(%2)
  %4: Duration = 180000000000
  %5: () = builtin! sleep(%4)
  %6: Ref(Kettle) = runtime entity.ref Kettle(%1.id)
  %7: Kettle = runtime! entity.read -(%6)
  %8.k: Kettle = %7
  %10: Phase = %8.k.phase
  jump b1
b1:
  %11: Bool = %10 is Brewing
  branch %11 b2 b4
b2:
  %12: Ref(Kettle) = runtime entity.ref Kettle(%1.id)
  %13: () = runtime! entity.call Kettle.finish(%12)
  jump b3
b3:
  return %9
b4:
  %14: Bool = %10 is Idle
  branch %14 b5 b6
b5:
  %16: () = ()
  jump b3
b6:
  %15: Bool = %10 is Done
  branch %15 b5 b7
b7:
  stop: no arm matches
