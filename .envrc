# direnv (https://direnv.net) puts this checkout's `eye` on your PATH while you
# are in the repository. Run `direnv allow` once.
#
# `eye` is scripts/eye: it rebuilds bin/eye from the sources when they have
# changed, so it is always this checkout's version.

if ! has go; then
  log_error "eye is built with Go 1.25 or later: https://go.dev/dl"
fi

PATH_add scripts
