#!/bin/sh
# Bootstrap once; the native command checks checkout freshness without
# starting Go and Git on every invocation.
set -e
root=$(cd "${0%/*}/.." && pwd)
bootstrap=
if [ ! -x "$root/bin/eye" ] || [ ! -f "$root/bin/.eye-checkout.json" ]; then
  (cd "$root" && go build -o bin/eye ./cmd/eye)
  bootstrap=1
fi
EYE_CHECKOUT_ROOT="$root" EYE_CHECKOUT_BOOTSTRAP="$bootstrap" exec "$root/bin/eye" "$@"
