// Duration is an Eyelang Duration, which goes over the wire as a whole
// number of milliseconds.
type Duration time.Duration

// MarshalJSON writes d in milliseconds.
func (d Duration) MarshalJSON() ([]byte, error) {
	return json.Marshal(time.Duration(d).Milliseconds())
}

// UnmarshalJSON reads a number of milliseconds.
func (d *Duration) UnmarshalJSON(data []byte) error {
	var ms int64
	if err := json.Unmarshal(data, &ms); err != nil {
		return fmt.Errorf("expected a number of milliseconds, found %s", describe(data))
	}
	*d = Duration(time.Duration(ms) * time.Millisecond)
	return nil
}

// Version is the version of something a service keeps, as the service gave
// it: a number or a string. A @fresh command takes it back as basedOn.
type Version = json.RawMessage

// Approval is a person's yes to a @destructive command: what they approved,
// and who they are.
type Approval struct {
	What string `json:"what"`
	By   string `json:"by"`
}

// Uncertain is the error a command returns when its reply was lost: the
// service may or may not have acted. Sending the command again with the same
// key finds out without acting twice, when the service keeps what each key
// did.
type Uncertain struct {
	Op  string // the operation, such as notify.send
	Key string // the key it was sent with; empty for a command without one
}

func (e *Uncertain) Error() string {
	if e.Key == "" {
		return e.Op + "'s reply was lost, so it may or may not have happened"
	}
	return fmt.Sprintf("%s's reply was lost, so it may or may not have happened; send it again with key %q to find out", e.Op, e.Key)
}

// The outcomes a @fresh command adds to its result. A server's method
// returns them as errors to answer with them.
var (
	// ErrStale is the outcome when the state the command acts on changed
	// after the version in basedOn, so it did nothing.
	ErrStale = errors.New("stale: the state changed after the version the command was based on, so it did nothing")
	// ErrExpired is the outcome when what the command was based on is gone,
	// so it can never apply.
	ErrExpired = errors.New("expired: what the command was based on is gone, so it can never apply")
)

// HTTPError is a reply whose status the operation doesn't take. For a query
// that returns Result(T, http.HttpError) it is the error the caller handles;
// for any other operation, a request the service refused. A server's method
// returns one to answer with its status and body.
type HTTPError struct {
	Op     string
	Status int
	Body   string
}

func (e *HTTPError) Error() string {
	body := e.Body
	if len(body) > 300 {
		body = body[:300] + "…"
	}
	return fmt.Sprintf("%s was refused with status %d: %s", e.Op, e.Status, body)
}

// plain reads a value that encoding/json reads as it is. An empty body is
// null.
func plain[T any](data json.RawMessage) (T, error) {
	var v T
	if len(bytes.TrimSpace(data)) == 0 {
		data = json.RawMessage("null")
	}
	err := json.Unmarshal(data, &v)
	return v, err
}

// fieldsOf reads a variant from a reply whose status names it: the body holds
// its fields, and an empty body none.
func fieldsOf[T any](data json.RawMessage) (T, error) {
	var v T
	if len(bytes.TrimSpace(data)) == 0 {
		data = json.RawMessage("{}")
	}
	err := json.Unmarshal(data, &v)
	return v, err
}

func isNull(data json.RawMessage) bool {
	d := bytes.TrimSpace(data)
	return len(d) == 0 || string(d) == "null"
}

// optional reads an Option: null, or a missing field, is nil.
func optional[T any](dec func(json.RawMessage) (T, error)) func(json.RawMessage) (*T, error) {
	return func(data json.RawMessage) (*T, error) {
		if isNull(data) {
			return nil, nil
		}
		v, err := dec(data)
		if err != nil {
			return nil, err
		}
		return &v, nil
	}
}

