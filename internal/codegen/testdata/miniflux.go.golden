	return func(data json.RawMessage) (T, error) {
		if isNull(data) {
			var zero T
			return zero, nil
		}
		return dec(data)
	}
}

func listOf[T any](dec func(json.RawMessage) (T, error)) func(json.RawMessage) ([]T, error) {
	return func(data json.RawMessage) ([]T, error) {
		var raws []json.RawMessage
		if isNull(data) || json.Unmarshal(data, &raws) != nil {
			return nil, fmt.Errorf("expected an array, found %s", describe(data))
		}
		out := make([]T, len(raws))
		for i, raw := range raws {
			v, err := dec(raw)
			if err != nil {
				return nil, fmt.Errorf("[%d]: %w", i, err)
			}
			out[i] = v
		}
		return out, nil
	}
}

func mapOf[K ~string, V any](dec func(json.RawMessage) (V, error)) func(json.RawMessage) (map[K]V, error) {
	return func(data json.RawMessage) (map[K]V, error) {
		var raws map[string]json.RawMessage
		if isNull(data) || json.Unmarshal(data, &raws) != nil {
			return nil, fmt.Errorf("expected an object, found %s", describe(data))
		}
		out := make(map[K]V, len(raws))
		for k, raw := range raws {
			v, err := dec(raw)
			if err != nil {
				return nil, fmt.Errorf("%s: %w", k, err)
			}
			out[K(k)] = v
		}
		return out, nil
	}
}

// kindOf reads the "kind" that tags a variant.
func kindOf(data json.RawMessage) (string, error) {
	var head struct {
		Kind *string `json:"kind"`
	}
	if err := json.Unmarshal(data, &head); err != nil || head.Kind == nil {
		return "", fmt.Errorf("expected an object with a kind, found %s", describe(data))
	}
	return *head.Kind, nil
}

// describe says what a JSON value is, for messages: a string or a number as
// it is, a list or an object by its kind.
func describe(data []byte) string {
	d := bytes.TrimSpace(data)
	if len(d) == 0 {
		return "nothing"
	}
	var x any
	if json.Unmarshal(d, &x) != nil {
		return "something that isn't JSON"
	}
	switch v := x.(type) {
	case string:
		return strconv.Quote(v)
	case []any:
		return "a list"
	case map[string]any:
		return "an object"
	}
	return string(d)
}

// tagged writes a variant's fields as an object tagged with its kind.
func tagged(kind string, fields any) ([]byte, error) {
	data, err := json.Marshal(fields)
	if err != nil {
		return nil, err
	}
	tag, _ := json.Marshal(kind)
	if string(data) == "{}" {
		return []byte("{\"kind\":" + string(tag) + "}"), nil
	}
	return append([]byte("{\"kind\":"+string(tag)+","), data[1:]...), nil
}

// freshOutcome is ErrStale or ErrExpired when a @fresh command's reply says
// one of them: {"kind": "Stale"}, or the name alone.
func freshOutcome(reply []byte, stale, expired string) error {
	var name string
	if json.Unmarshal(reply, &name) != nil {
		name, _ = kindOf(reply)
	}
	switch name {
	case "Stale", stale:
		return ErrStale
	case "Expired", expired:
		return ErrExpired
	}
	return nil
}

// emptyIfNil gives a nil slice or map as an empty one, which encoding/json
// would write as null.
func emptyIfNil(v any) any {
	rv := reflect.ValueOf(v)
	switch {
	case rv.Kind() == reflect.Slice && rv.IsNil():
		return []any{}
	case rv.Kind() == reflect.Map && rv.IsNil():
		return map[string]any{}
	}
	return v
}

// text is a value as a path segment or a query parameter takes it: a string
// as it is, anything else as JSON.
func text(data json.RawMessage) string {
	var s string
	if json.Unmarshal(data, &s) == nil {
		return s
	}
	return string(bytes.TrimSpace(data))
}

// ---------------------------------------------------------------- clients

// call is one request, as an operation's @http describes it.
type call struct {
	op     string // the operation, such as notify.send
	method string
	path   []string // its segments, with the arguments put in
	query  url.Values
	body   map[string]json.RawMessage
	whole  json.RawMessage // the body, in place of body's fields: an event's value
	header http.Header
}

func newCall(op, method, path string) *call {
	return &call{op: op, method: method, path: strings.Split(path, "/"), query: url.Values{}, body: map[string]json.RawMessage{}, header: http.Header{}}
}

// put adds an argument in the path, the query or the body.
func (c *call) put(in, name string, v any) error {
	data, err := json.Marshal(emptyIfNil(v))
	if err != nil {
		return fmt.Errorf("%s's argument %s: %w", c.op, name, err)
	}
	c.putJSON(in, name, data)
	return nil
}

// putJSON adds an argument as JSON. In the query, a list is the parameter
// repeated, and null is left out.
func (c *call) putJSON(in, name string, data json.RawMessage) {
	switch in {
	case "path":
		for i, seg := range c.path {
			if seg == ":"+name {
				c.path[i] = url.PathEscape(text(data))
			}
		}
	case "query":
		var list []json.RawMessage
		switch {
		case isNull(data):
		case bytes.HasPrefix(bytes.TrimSpace(data), []byte("[")) && json.Unmarshal(data, &list) == nil:
			for _, e := range list {
				c.query.Add(name, text(e))
			}
		default:
			c.query.Set(name, text(data))
		}
	default:
		c.body[name] = data
	}
}

func (c *call) badReply(status int, want string, err error) error {
	return fmt.Errorf("%s answered %d with a body that isn't %s: %w", c.op, status, want, err)
}

// transport is where a client sends its calls, and the credential it adds.
type transport struct {
	baseURL    string
	client     *http.Client
	authHeader string
	authValue  string
}

// send makes the request and returns the reply's status and body.
func (t transport) send(ctx context.Context, c *call) (int, []byte, error) {
	target := strings.TrimSuffix(t.baseURL, "/") + strings.Join(c.path, "/")
	if len(c.query) > 0 {
		target += "?" + c.query.Encode()
	}
	var body io.Reader
	if c.method != "GET" && c.method != "DELETE" {
		data, err := json.Marshal(c.body)
		if err != nil {
			return 0, nil, err
		}
		if c.whole != nil {
			data = c.whole
		}
		body = bytes.NewReader(data)
		c.header.Set("Content-Type", "application/json")
	}
	req, err := http.NewRequestWithContext(ctx, c.method, target, body)
	if err != nil {
		return 0, nil, err
	}
	req.Header = c.header
	req.Header.Set("Accept", "application/json")
	if t.authHeader != "" {
		req.Header.Set(t.authHeader, t.authValue)
	}
	client := t.client
	if client == nil {
		client = http.DefaultClient
	}
	resp, err := client.Do(req)
	if err != nil {
		return 0, nil, err
	}
	defer func() { _ = resp.Body.Close() }()
	reply, err := io.ReadAll(io.LimitReader(resp.Body, 32<<20))
	return resp.StatusCode, reply, err
}

// notSent reports whether a request failed before it reached the service,
// so that sending it again can't do anything twice.
func notSent(err error) bool {
	var op *net.OpError
	if errors.As(err, &op) && op.Op == "dial" {
		return true
	}
	var dns *net.DNSError
	return errors.As(err, &dns)
}

// ---------------------------------------------------------------- servers

// server answers the requests to one contract.
type server struct {
	name       string // the contract, such as notify.Notify
	authHeader string // the header @auth names; empty without @auth
	secret     string
	bearer     bool
	routes     []route
}

// route is one operation's request: its method and its path's segments,
// where ":name" takes the argument of that name.
type route struct {
	op       string
	method   string
	segments []string
	serve    func(*request) reply
}

// request is what a request gives an operation.
type request struct {
	ctx    context.Context
	op     string
	path   map[string]string // the path's :name segments, unescaped
	query  url.Values        // for GET and DELETE
	body   map[string]json.RawMessage
	header http.Header
}

type reply struct {
	status      int
	body        []byte
	contentType string
}

func (s *server) ServeHTTP(w http.ResponseWriter, r *http.Request) {
	// The credential is checked first, so a caller without it learns
	// nothing, not even which paths exist.
	if s.authHeader != "" {
		want := s.secret
		how := "the secret"
		if s.bearer {
			want, how = "Bearer "+s.secret, "Bearer and the secret"
		}
		if s.secret == "" || subtle.ConstantTimeCompare([]byte(r.Header.Get(s.authHeader)), []byte(want)) != 1 {
			writeReply(w, errorReply(http.StatusUnauthorized, fmt.Sprintf("%s takes only requests with %s in the %s header", s.name, how, s.authHeader)))
			return
		}
	}
	rt, path, allowed := s.match(r.Method, r.URL.EscapedPath())
	if rt == nil {
		if len(allowed) > 0 {
			w.Header().Set("Allow", strings.Join(allowed, ", "))
			writeReply(w, errorReply(http.StatusMethodNotAllowed, fmt.Sprintf("%s takes %s, not %s", r.URL.Path, strings.Join(allowed, " or "), r.Method)))
			return
		}
		writeReply(w, errorReply(http.StatusNotFound, fmt.Sprintf("%s has no operation at %s %s", s.name, r.Method, r.URL.Path)))
		return
	}
	data, err := io.ReadAll(io.LimitReader(r.Body, 32<<20))
	if err != nil {
		writeReply(w, errorReply(http.StatusBadRequest, "the request's body couldn't be read: "+err.Error()))
		return
	}
	req := &request{ctx: r.Context(), op: rt.op, path: path, query: url.Values{}, body: map[string]json.RawMessage{}, header: r.Header}
	if rt.method == "GET" || rt.method == "DELETE" {
		req.query = r.URL.Query()
	} else if !isNull(data) {
		var x any
		if err := json.Unmarshal(data, &x); err != nil {
			writeReply(w, errorReply(http.StatusBadRequest, "the body isn't JSON: "+err.Error()))
			return
		}
		if json.Unmarshal(data, &req.body) != nil {
			writeReply(w, errorReply(http.StatusBadRequest, fmt.Sprintf("the body must be a JSON object of %s's arguments, found %s", rt.op, describe(data))))
			return
		}
	}
	writeReply(w, rt.serve(req))
}

// match finds the route for a request. allowed lists the methods its path
// takes when only the method is wrong.
func (s *server) match(method, path string) (*route, map[string]string, []string) {
	segments := strings.Split(path, "/")
	var allowed []string
	for i := range s.routes {
		rt := &s.routes[i]
		if len(rt.segments) != len(segments) {
			continue
		}
		vals := map[string]string{}
		ok := true
		for j, seg := range rt.segments {
			if name, isArg := strings.CutPrefix(seg, ":"); isArg {
				v, err := url.PathUnescape(segments[j])
				if err != nil || v == "" {
					ok = false
					break
				}
				vals[name] = v
			} else if seg != segments[j] {
				ok = false
				break
			}
		}
		switch {
		case !ok:
		case rt.method == method:
			return rt, vals, nil
		default:
			allowed = append(allowed, rt.method)
		}
	}
	return nil, nil, allowed
}

// arg reads an argument from the path, a query parameter or the body. found
// is false when the request leaves it out; a null counts as left out only
// for an Option.
func arg[T any](r *request, in, name string, option bool, dec func(json.RawMessage) (T, error)) (v T, found bool, err error) {
	switch in {
	case "path":
		s, ok := r.path[name]
		if !ok {
			return v, false, nil
		}
		v, err = fromText(s, dec)
		return v, true, err
	case "query":
		vals, ok := r.query[name]
		if !ok || len(vals) == 0 {
			return v, false, nil
		}
		v, err = fromText(vals[0], dec)
		return v, true, err
	}
	data, ok := r.body[name]
	if !ok {
		return v, false, nil
	}
	if isNull(data) {
		if option {
			return v, false, nil
		}
		return v, true, errors.New("expected a value, found null")
	}
	v, err = dec(data)
	return v, true, err
}

// argList reads a list argument: in the query, the parameter repeated.
func argList[T any](r *request, in, name string, option bool, dec func(json.RawMessage) (T, error)) ([]T, bool, error) {
	if in != "query" {
		return arg(r, in, name, option, listOf(dec))
	}
	vals, ok := r.query[name]
	if !ok {
		return nil, false, nil
	}
	out := make([]T, len(vals))
	for i, s := range vals {
		v, err := fromText(s, dec)
		if err != nil {
			return nil, true, fmt.Errorf("[%d]: %w", i, err)
		}
		out[i] = v
	}
	return out, true, nil
}

// fromText reads an argument written as text, in a path segment or a query
// parameter: a string as it is, anything else as JSON (5, true, null).
func fromText[T any](s string, dec func(json.RawMessage) (T, error)) (T, error) {
	quoted, _ := json.Marshal(s)
	v, err := dec(quoted)
	if err == nil {
		return v, nil
	}
	if json.Valid([]byte(s)) {
		if v, jerr := dec(json.RawMessage(s)); jerr == nil {
			return v, nil
		}
	}
	return v, err
}

// key reads a command's key from its header, or from its body field.
func (r *request) key(header, field string) (string, bool) {
	if k := r.header.Get(header); k != "" {
		return k, true
	}
	if field != "" {
		var k string
		if json.Unmarshal(r.body[field], &k) == nil && k != "" {
			return k, true
		}
	}
	return "", false
}

func (r *request) noKey(header, field string) reply {
	where := "the " + header + " header"
	if field != "" {
		where += " or the body's field " + field
	}
	return errorReply(http.StatusBadRequest, fmt.Sprintf("%s takes a key, in %s", r.op, where))
}

func (r *request) missing(name string) reply {
	return errorReply(http.StatusBadRequest, fmt.Sprintf("%s's argument %s: it is missing", r.op, name))
}

func (r *request) badArg(name string, err error) reply {
	return errorReply(http.StatusBadRequest, fmt.Sprintf("%s's argument %s: %v", r.op, name, err))
}

func (r *request) fault(err error) reply {
	return errorReply(http.StatusInternalServerError, fmt.Sprintf("%s faulted: %v", r.op, err))
}

// failure is how an operation answers its method's errors.
type failure struct {
	fresh          bool // a @fresh command: ErrStale and ErrExpired are outcomes
	stale, expired int  // their statuses
	httpErr        bool // it returns Result(T, http.HttpError)
}

func (r *request) failed(err error, f failure) reply {
	var h *HTTPError
	switch {
	case f.fresh && errors.Is(err, ErrStale):
		return reply{status: f.stale, body: []byte("{\"kind\":\"Stale\"}\n"), contentType: "application/json"}
	case f.fresh && errors.Is(err, ErrExpired):
		return reply{status: f.expired, body: []byte("{\"kind\":\"Expired\"}\n"), contentType: "application/json"}
	case f.httpErr && errors.As(err, &h) && h.Status >= 100 && h.Status <= 999:
		return reply{status: h.Status, body: []byte(h.Body), contentType: "text/plain; charset=utf-8"}
	case f.httpErr:
		return errorReply(http.StatusBadGateway, fmt.Sprintf("%s: %v", r.op, err))
	}
	return r.fault(err)
}

// answer is a result's reply, in the one JSON shape.
func (r *request) answer(status int, v any) reply {
	data, err := json.Marshal(emptyIfNil(v))
	if err != nil {
		return r.fault(fmt.Errorf("its result can't be written as JSON: %w", err))
	}
	return reply{status: status, body: append(data, '\n'), contentType: "application/json"}
}

// errorReply is a refusal: { "error": "…" }.
func errorReply(status int, msg string) reply {
	data, _ := json.Marshal(map[string]string{"error": msg})
	return reply{status: status, body: append(data, '\n'), contentType: "application/json"}
}

func writeReply(w http.ResponseWriter, rep reply) {
	w.Header().Set("Content-Type", rep.contentType)
	w.WriteHeader(rep.status)
	_, _ = w.Write(rep.body)
}
