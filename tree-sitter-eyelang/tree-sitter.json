{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "eyelang",
      "camelcase": "Eyelang",
      "title": "Eyelang",
      "scope": "source.eyelang",
      "path": ".",
      "file-types": ["eye"],
      "highlights": "queries/highlights.scm",
      "locals": "queries/locals.scm",
      "injection-regex": "^(eye|eyelang)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "description": "Eyelang grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/ruxxzebre/eyelang"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
